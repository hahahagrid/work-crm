# =========================================================
# Sales CRM — Environment Variables Template
# Copy this file to `.env.local` and fill in real values.
# NEVER commit the real .env.local file!
# =========================================================

# ----- Database (PostgreSQL via Railway) -----
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# ----- CRM API Security -----
# Secret token used by the Chrome Extension to authenticate requests to the CRM API.
# Generate a strong random string: openssl rand -hex 32
EXTENSION_API_SECRET="your-strong-secret-here"

# ----- App URL -----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
